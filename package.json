{
  "name": "kyonenya.github.io",
  "version": "2.5.0",
  "scripts": {
    "dev": "node index.mjs",
    "tsc": "tsc -w --noEmit",
    "tsc:once": "tsc --noEmit",
    "build": "node ./node_modules/webpack/bin/webpack.js",
    "build-css": "postcss src/css/index.css -o dist/css/bundle.css --verbose",
    "fmt": "prettier --write **/*.{ts,js,mjs,json,css}",
    "lint": "eslint --fix src/**/*.ts",
    "lint-css": "node ./node_modules/stylelint/bin/stylelint.mjs src/**/*.css",
    "lint-css:fix": "node ./node_modules/stylelint/bin/stylelint.mjs src/**/*.css --fix"
  },
  "dependencies": {
    "search-summary": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "18.19.130",
    "citeproc": "^2.4.63",
    "csl-json": "^0.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "postcss-csso": "^6.0.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "sitemap": "^8.0.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.5",
    "xml-formatter": "^3.7.0"
  },
  "prettier": {
    "singleQuote": true
  }
}
