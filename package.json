{
  "name": "kyonenya.github.io",
  "version": "2.5.0",
  "scripts": {
    "dev": "node index.js",
    "tsc": "tsc -w --noEmit",
    "tsc:js": "tsc -w --noEmit --resolveJsonModule --p tsconfig.checkjs.json",
    "build": "webpack",
    "build:css": "postcss src/css/index.css -o dist/css/bundle.css",
    "fmt": "prettier --write **/*.{ts,js,json,css}",
    "lint": "eslint --fix src/**/*.ts",
    "lint:css": "stylelint src/**/*.css"
  },
  "dependencies": {
    "search-summary": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.57.2",
    "citeproc": "^2.4.63",
    "csl-json": "^0.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.3",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "markdown-it": "^13.0.1",
    "markdown-it-footnote": "^3.0.3",
    "postcss": "^8.3.0",
    "postcss-cli": "^8.3.1",
    "postcss-csso": "^5.0.1",
    "postcss-import": "^14.0.2",
    "prettier": "^3.8.3",
    "sitemap": "^9.0.1",
    "stylelint": "^13.13.1",
    "stylelint-cli": "^1.3.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^22.0.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^8.0.3",
    "xml-formatter": "^3.7.0"
  },
  "prettier": {
    "singleQuote": true
  }
}
